<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Show guides for the folders: TMDB, Watchmode and Netflix's Top 10. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The stick's own Wi-Fi address, for the photo upload page's QR code. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice search, through the remote's microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Watch time per app, to put the most-watched apps first. Granted once over adb:
         appops set com.redmesastudios.simpletv GET_USAGE_STATS allow -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets SimpleTV see and launch the other TV apps installed on the box. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@mipmap/ic_launcher"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleTV">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets SimpleTV answer the Home button as the box's home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The remote's extra buttons, system-wide. See RemoteButtons.kt. It runs in its own
             process: every remote press waits on it, so it must never queue behind SimpleTV's
             screen work, or a held-up release turns one press into several. -->
        <service
            android:name=".RemoteButtons"
            android:exported="false"
            android:process=":buttons"
            android:label="@string/remote_buttons_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_buttons" />
        </service>
    </application>

</manifest>
